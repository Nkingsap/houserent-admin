# Supabase project credentials — copy this file to .env.local and fill it in.
# Both values are safe to ship to the browser: the publishable key is public and
# every data operation is authorised server-side against the public.admins allowlist.
#
# Vercel: add these under Project → Settings → Environment Variables.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
